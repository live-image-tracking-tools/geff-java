		<name>Live Image Tracking Tools (LITT)</name>
		<url>https://github.com/live-image-tracking-tools</url>
	</organization>
	<licenses>
		<license>
			<name>BSD-2-Clause</name>
			<url>https://opensource.org/licenses/BSD-2-Clause</url>
		</license>
	</licenses>

